<mxCell id="c157" value="&amp;#8226; Producers never communicate directly with consumers.&lt;br/&gt;&lt;br/&gt;&amp;#8226; Routing is based on event content rather than destination." style="text;html=1;fontSize=11;fontStyle=0;fontColor=#DFE1E6;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="65.0" y="883" width="576.6666666666666" height="145" as="geometry"/></mxCell>
<mxCell id="c158" value="&amp;#8226; New consumers can be added without changing publishers.&lt;br/&gt;&lt;br/&gt;&amp;#8226; Operational and analytics workloads remain independent." style="text;html=1;fontSize=11;fontStyle=0;fontColor=#DFE1E6;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="661.6666666666666" y="883" width="576.6666666666666" height="145" as="geometry"/></mxCell>
<mxCell id="c159" value="&amp;#8226; Supports loose coupling and future extensibility." style="text;html=1;fontSize=11;fontStyle=0;fontColor=#DFE1E6;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1258.3333333333333" y="883" width="576.6666666666666" height="145" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
