<mxCell id="c148" value="KEY ARCHITECTURAL BENEFITS" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#ffffff;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1300" y="853" width="400" height="24" as="geometry"/></mxCell>
