<mxCell id="c150" value="&amp;#8226; Supports retries and DLQs&lt;br/&gt;&lt;br/&gt;&amp;#8226; Complete operational visibility&lt;br/&gt;&lt;br/&gt;&amp;#8226; No message disappears without trace&lt;br/&gt;&lt;br/&gt;TTL provides controlled lifecycle retention." style="text;html=1;fontSize=11;fontStyle=0;fontColor=#DFE1E6;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1577.5" y="883" width="257.5" height="145" as="geometry"/></mxCell>
