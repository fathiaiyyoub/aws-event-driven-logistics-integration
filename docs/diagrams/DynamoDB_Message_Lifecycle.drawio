<mxCell id="c145" value="&lt;b&gt;INDEPENDENT STATUS DIMENSIONS&lt;/b&gt;&lt;table style='width:100%;font-size:11px;margin-top:10px'&gt;&lt;tr&gt;&lt;td style='padding:4px 10px'&gt;&lt;b&gt;Processing Status&lt;/b&gt;&lt;br/&gt;RECEIVED&lt;br/&gt;PROCESSING&lt;br/&gt;SUCCEEDED&lt;br/&gt;FAILED / DLQ&lt;/td&gt;&lt;td style='padding:4px 10px'&gt;&lt;b&gt;Delivery Status&lt;/b&gt;&lt;br/&gt;NOT_STARTED&lt;br/&gt;PENDING&lt;br/&gt;DELIVERED / DELIVERY_FAILED&lt;br/&gt;NOT_REQUIRED / FAILED&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8FC7FF;strokeWidth=2;dashed=0;fontSize=12;fontStyle=0;align=left;verticalAlign=top;fontColor=#172B4D;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="30" y="838" width="590" height="200" as="geometry"/></mxCell>
<mxCell id="c146" value="&lt;b&gt;Processing ≠ Delivery&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px'&gt;Processing and delivery are tracked independently, so successful processing does not imply successful delivery.&lt;br/&gt;&lt;br/&gt;This distinction supports accurate retries, investigation and recovery.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#DFE1E6;strokeWidth=2;dashed=0;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontColor=#172B4D;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="635" y="838" width="610" height="200" as="geometry"/></mxCell>
